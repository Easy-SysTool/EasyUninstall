<Window
    x:Class="EasyUninstall.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:EasyUninstall.Converters"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom-drawn title bar row: icon + title, drag region for the window -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image x:Name="AppIcon" Width="16" Height="16"
                       Source="ms-appx:///Images/Square44x44.targetsize-16_altform-unplated.png"/>
                <TextBlock x:Name="AppTitleText" Text="EasyUninstall"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="180">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemAll" Content="全部软件" Tag="All" Icon="AllApps" IsSelected="True"/>
                <NavigationViewItem x:Name="NavItemDesktop" Content="桌面应用" Tag="Desktop" Icon="Download"/>
                <NavigationViewItem x:Name="NavItemStore" Content="商店应用" Tag="Store" Icon="Shop"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemSettings" Content="设置" Tag="Settings" Icon="Setting">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Visibility="Collapsed"/>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackgroundBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackgroundBrush" Color="Transparent"/>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            </NavigationView.Resources>
            <Grid Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar: search, sort, refresh -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" PlaceholderText="按名称搜索…" Width="240"/>
                    <ComboBox x:Name="SortCombo" SelectedIndex="0" MinWidth="120">
                        <ComboBoxItem x:Name="SortItemName" Content="名称"/>
                        <ComboBoxItem x:Name="SortItemDate" Content="安装日期"/>
                        <ComboBoxItem x:Name="SortItemPublisher" Content="发布者"/>
                    </ComboBox>
                    <ToggleButton x:Name="SortDescToggle" Content="降序"/>
                    <Button x:Name="RefreshButton" Content="刷新"/>
                </StackPanel>

                <!-- App list -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="48" Height="48"/>
                        <TextBlock x:Name="EmptyText" Text="未发现软件" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ListView x:Name="AppList" SelectionMode="Single" IsItemClickEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="32" Height="32">
                                            <Grid.Resources>
                                                <conv:IconFallbackVisibilityConverter x:Key="IconFallbackVisibility"/>
                                            </Grid.Resources>
                                            <TextBlock x:Name="PackageFallback" Text="📦" FontSize="20"
                                                       Visibility="{Binding IconPath, Converter={StaticResource IconFallbackVisibility}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding IconPath}" Width="32" Height="32"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Publisher}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayVersion}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Detail pane: shown when an app is selected -->
                    <Border x:Name="DetailPane" Grid.Column="1" Width="300" Margin="12,0,0,0"
                            Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="DetailName" FontWeight="SemiBold" FontSize="16"
                                       TextWrapping="Wrap"/>
                            <InfoBar x:Name="DetailWarn" Severity="Warning" IsOpen="False" IsClosable="False"/>
                            <StackPanel x:Name="DetailFields" Spacing="6">
                                <TextBlock x:Name="DetailVersion" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailPublisher" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailInstallDate" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailLocation" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button x:Name="UninstallButton" Content="卸载" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                            <Button x:Name="ForceUninstallButton" Content="强制卸载"
                                    HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Status bar / error feedback -->
                <InfoBar x:Name="ErrorBar" Grid.Row="2" IsOpen="False" Severity="Error"
                         Margin="0,8,0,0"/>
                <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
